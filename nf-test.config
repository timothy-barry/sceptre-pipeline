config {
    testsDir 'tests'
    // Frozen benchmark evidence is historical source, not executable project code.
    ignore 'benchmark/evidence/**'
    workDir(System.getenv('SCEPTRE_NFTEST_WORKDIR') ?: '.nf-test')
    configFile 'conf/test.config'
    profile 'test'
    requires('nf-test': '0.9.5')
}

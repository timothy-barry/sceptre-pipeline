nextflow_process {
    name 'Validate certified runtime module'
    script "modules/local/sceptre_validate/main.nf"
    process 'SCEPTRE_VALIDATE'
    tag 'module'
    test('Checks real serialized input and emits a readiness gate') {
        when {
            params {
                container_image = System.getenv('SCEPTRE_CONTAINER_IMAGE')
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = tuple([id: 'fixture'], file('${System.getenv('SCEPTRE_TEST_FIXTURE')}/input'))
                input[1] = file('${System.getenv('SCEPTRE_TEST_FIXTURE')}/config.rds')
                input[2] = file('${System.getenv('SCEPTRE_TEST_FIXTURE')}/lock.rds')
                input[3] = file('$baseDir/resources/empty_backing')
                input[4] = file('$baseDir/bin')
                input[5] = file('$baseDir/resources/no_previous_run.rds')
                input[6] = '{}'
                input[7] = [file('$baseDir/main.nf'), file('$baseDir/nextflow.config')]
                """
            }
        }
        then {
            assert process.success
            assert process.out.ready == [true]
            assert path(process.out.signature[0]).size() > 0
        }
    }
}

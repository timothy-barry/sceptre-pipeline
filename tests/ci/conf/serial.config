// Test-only scheduling policy; scientific worker code and random streams are unchanged.
executor.queueSize = 1
process {
    withName: '.*SCEPTRE_WORKER' { maxForks = 1 }
}
trace.raw = true
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,attempt,workdir'

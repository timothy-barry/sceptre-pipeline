// Bounded concurrency with a discarded completed proposal, then a real retry.
executor.queueSize = 2
process {
    withName: '.*SCEPTRE_WORKER' {
        maxForks = 2
        errorStrategy = { task.exitStatus == 42 ? 'retry' : 'terminate' }
        maxRetries = 1
        // Delays alter completion order only; no statistical input or seed changes.
        beforeScript = { "sleep ${unit_id == 'unit-000001' ? 12 : 1}" }
        // afterScript runs after the native worker has written its proposal.
        afterScript = { unit_id == 'unit-000001' && task.attempt == 1 ?
            'echo SCHEDULING_RETRY_AFTER_PROPOSAL >&2; exit 42' : 'true' }
    }
}
trace.raw = true
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,attempt,workdir'

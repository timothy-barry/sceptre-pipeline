// Scheduler-only fixture: no R, count data or scientific result claims.
manifest.nextflowVersion = '>=25.10.4'
params {
    array_size = 2
    n_items = 5
    fail_item = 0
    outdir = 'array-smoke-results'
}
includeConfig '../../conf/base.config'
profiles {
    slurm { includeConfig '../../conf/slurm.config' }
}
process {
    withLabel: process_single { cpus = 1; memory = '128 MB'; time = '2m' }
    withLabel: process_medium { cpus = 1; memory = '128 MB'; time = '2m' }
}
trace.enabled = true
trace.file = "${params.outdir}/trace.tsv"
trace.overwrite = true

// Benchmark-only limits; no production config or statistical settings are changed.
executor.cpus = 2
executor.memory = '7 GB'
process {
    cpus = 1
    memory = '3 GB'
    time = '15m'
    maxForks = 2
    withLabel: process_single { cpus = 1; memory = '3 GB'; time = '15m' }
    withLabel: process_medium { cpus = 1; memory = '3 GB'; time = '15m' }
}
docker.runOptions = "--cpus=1 --memory-swap=3g --entrypoint ${projectDir}/benchmark/container-entrypoint.sh"
